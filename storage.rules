// Firebase Storage Security Rules for TomeVault.
// Controls who can upload and download files (e.g., avatar images).
// BEGINNER NOTE: request.resource.size limits file size to prevent abuse.
// request.resource.contentType restricts uploads to images only.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Handout images can be slightly larger than avatars/templates.
    match /users/{uid}/handouts/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 12 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Users can upload/read their own files under users/{uid}/
    match /users/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
