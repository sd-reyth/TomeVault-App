# Copy this file to `.env` and fill in your Firebase web app config.
# Firebase Console → Project settings → Your apps → Web app config.
# Never commit `.env` — it is gitignored.

VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Optional: canonical public URL for invite links (defaults to Firebase Hosting URL).
# VITE_PUBLIC_APP_ORIGIN=https://your-project.web.app

# Optional: Firebase App Check (reCAPTCHA v3 site key from Firebase Console → App Check)
# VITE_FIREBASE_APP_CHECK_SITE_KEY=your-recaptcha-v3-site-key
# VITE_FIREBASE_APP_CHECK_DEBUG_TOKEN=your-local-debug-token
