// Firestore Security Rules for TomeVault.
// These rules control who can read/write data in the database.
// BEGINNER NOTE: Rules run server-side - even if someone modifies the client
// code, these rules still protect the data. Each match block specifies a
// document path and the conditions under which reads/writes are allowed.
// Private replication glossary is intentionally kept in local-only notes at
// .private/REPLICATION_NOTES.md (gitignored).
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: fetch the GM UID from the parent session
    function isGM(sessionId) {
      return request.auth != null
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.gmUid == request.auth.uid;
    }

    // User profiles
    match /users/{userId} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null && request.auth.uid == userId;

      // Memberships subcollection — cross-device session discovery
      match /memberships/{membershipId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Sessions
    match /sessions/{sessionId} {
      allow read:  if request.auth != null;

      // Any authenticated user can create a new session (they become the GM)
      allow create: if request.auth != null
                    && request.resource.data.gmUid == request.auth.uid;

      // Only the GM can update or delete the session
      allow update, delete: if isGM(sessionId);

      // Allow a player to take over the GM role via:
      // a) GM transfer PIN set on the session (player self-service), or
      // b) A pending transfer document (GM-initiated transfer flow).
      // The player can only change gmUid (to themselves) and updatedAt.
      //
      // LEARNING NOTE:
      // `diff(resource.data).affectedKeys().hasOnly([...])` is critical here.
      // Without this guard, a malicious client could attempt to modify any
      // writable session field during takeover (for example, ambience or joinTag).
      // We intentionally permit only gmUid + updatedAt in this special path.
      //
      // The OR block below represents two allowed takeover mechanisms:
      // 1) Session has a non-empty dmTransferPinHash (manual PIN handoff flow).
      // 2) A pendingTransfer/current document exists (explicit transfer workflow).
      allow update: if request.auth != null
                    && request.resource.data.gmUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gmUid', 'updatedAt'])
                    && (
                      (resource.data.dmTransferPinHash is string
                       && resource.data.dmTransferPinHash.size() > 0)
                      || exists(/databases/$(database)/documents/sessions/$(sessionId)/pendingTransfer/current)
                    );

      // Wallets (party treasury + per-player)
      match /wallets/{walletId} {
        allow read: if request.auth != null;

        // GM can edit any wallet
        // Players can edit only their own wallet (walletId === uid)
        // "party" wallet is GM-only (handled by the first condition)
        allow write: if isGM(sessionId)
                     || (request.auth != null && walletId == request.auth.uid);
      }

      // Handouts
      match /handouts/{handoutId} {
        allow read: if request.auth != null;

        // GM retains full control over handouts.
        allow create, delete: if isGM(sessionId);

        // Player self-claim: tightly scoped update so only claim metadata can
        // be written, and only when the loot is currently unclaimed + claimable,
        // or when the current owner is returning it back to the shared pool.
        allow update: if isGM(sessionId) || (
          request.auth != null
          && resource.data.claimable == true
          && (
            resource.data.type == 'loot'
            || resource.data.type == 'Loot'
            || resource.data.type == 'LOOT'
          )
          && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly(['claimedByUid', 'claimedByNick', 'mapVisibleToUid', 'claimedAt', 'updatedAt'])
          && (
            (
              (
                !(resource.data.claimedByUid is string)
                || resource.data.claimedByUid.size() == 0
              )
              && request.resource.data.claimedByUid == request.auth.uid
              && request.resource.data.claimedByNick is string
              && request.resource.data.mapVisibleToUid == null
            )
            ||
            (
              resource.data.claimedByUid is string
              && resource.data.claimedByUid == request.auth.uid
              && request.resource.data.claimedByUid == null
              && request.resource.data.claimedByNick == null
              && request.resource.data.mapVisibleToUid == null
              && request.resource.data.claimedAt == null
            )
          )
        );
      }

      // Notes (per-player, synced across devices)
      match /notes/{noteOwnerId} {
        allow read: if request.auth != null && request.auth.uid == noteOwnerId;
        allow write: if request.auth != null && request.auth.uid == noteOwnerId;
      }

      // Note files (multi-note session journaling)
      match /noteFiles/{noteId} {
        allow read: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;

        allow create: if request.auth != null
                      && request.resource.data.ownerUid == request.auth.uid;

        allow update: if request.auth != null
                      && resource.data.ownerUid == request.auth.uid
                      && request.resource.data.ownerUid == resource.data.ownerUid;

        allow delete: if request.auth != null
                      && resource.data.ownerUid == request.auth.uid;
      }

      // Players (presence / heartbeat)
      match /players/{playerId} {
        allow read: if request.auth != null;
        allow write: if isGM(sessionId)
                     || (request.auth != null && playerId == request.auth.uid);
      }

      // Inventory items
      match /inventory/{itemId} {
        allow read: if request.auth != null;

        // GM can do anything
        allow write: if isGM(sessionId);

        // Players can CREATE items where they set themselves as owner
        allow create: if request.auth != null
                      && (
                        request.resource.data.ownerUid == request.auth.uid
                        || request.resource.data.ownerId == request.auth.uid
                      );

        // Players can UPDATE / DELETE their own items
        allow update, delete: if request.auth != null
                              && (
                                resource.data.ownerUid == request.auth.uid
                                || resource.data.ownerId == request.auth.uid
                              );
      }

      // Notifications (per-player, in-app)
      match /notifications/{notifId} {
        allow read: if request.auth != null;

        // GM can create notifications for any player
        allow create: if isGM(sessionId);

        // Target player can mark their own notifications as read
        allow update: if request.auth != null
                      && resource.data.targetUid == request.auth.uid;

        // GM or target player can delete
        allow delete: if isGM(sessionId)
                      || (request.auth != null && resource.data.targetUid == request.auth.uid);
      }

      // Shared session chat
      match /chatMessages/{messageId} {
        allow read: if request.auth != null;

        allow create: if request.auth != null
                      && request.resource.data.keys().hasOnly(['uid', 'displayName', 'avatarUrl', 'message', 'createdAt', 'expireAt', 'color', 'replyTo', 'clientMessageId', 'updatedAt'])
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.uid is string
                      && request.resource.data.uid.size() > 0
                      && request.resource.data.displayName is string
                      && request.resource.data.displayName.size() > 0
                      && request.resource.data.displayName.size() <= 60
                      && (
                        !('avatarUrl' in request.resource.data)
                        || (
                          request.resource.data.avatarUrl is string
                          && request.resource.data.avatarUrl.size() <= 2048
                        )
                      )
                      && request.resource.data.message is string
                      && request.resource.data.message.size() > 0
                      && request.resource.data.message.size() <= 500
                      && request.resource.data.createdAt is timestamp
                      && request.resource.data.expireAt is timestamp
                      && (!(request.resource.data.color is string) || request.resource.data.color.size() <= 24)
                      && (!(request.resource.data.clientMessageId is string) || request.resource.data.clientMessageId.size() <= 80)
                      && (
                        request.resource.data.replyTo == null
                        || (
                          request.resource.data.replyTo is map
                          && request.resource.data.replyTo.keys().hasOnly(['author', 'text'])
                          && request.resource.data.replyTo.author is string
                          && request.resource.data.replyTo.author.size() <= 60
                          && request.resource.data.replyTo.text is string
                          && request.resource.data.replyTo.text.size() <= 500
                        )
                      );

        allow update: if request.auth != null
                      && (isGM(sessionId) || resource.data.uid == request.auth.uid)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['message', 'color', 'updatedAt'])
                      && request.resource.data.uid == resource.data.uid
                      && request.resource.data.displayName == resource.data.displayName
                      && request.resource.data.createdAt == resource.data.createdAt
                      && request.resource.data.expireAt == resource.data.expireAt
                      && request.resource.data.message is string
                      && request.resource.data.message.size() > 0
                      && request.resource.data.message.size() <= 500
                      && (!(request.resource.data.color is string) || request.resource.data.color.size() <= 24);

        allow delete: if isGM(sessionId)
                      || (request.auth != null && resource.data.uid == request.auth.uid);
      }

      // Character templates (GM-managed)
      match /characterTemplates/{templateId} {
        allow read: if request.auth != null;
        allow create, delete: if isGM(sessionId);

        // GM can update anything; assigned player can update assignmentStatus
        allow update: if isGM(sessionId)
                      || (request.auth != null
                          && resource.data.assignedToUid == request.auth.uid);
      }

      // Pending GM role transfer
      match /pendingTransfer/{transferId} {
        allow read: if request.auth != null;
        allow create: if isGM(sessionId);

        // LEARNING NOTE:
        // This collection acts like a short-lived handshake record between
        // current GM and target player. Broad update/delete are allowed here
        // because transfer state transitions are coordinated by client flow,
        // while the actual authority change remains guarded above in sessions.
        // Target player or GM can delete (accept/decline)
        allow delete: if request.auth != null;
        allow update: if request.auth != null;
      }
    }
  }
}

